// Sitio estático en Cloudflare (Workers static assets).
// Publicar: npm run build && npx wrangler deploy
{
  "name": "estudiolcb",
  "account_id": "a2df92c02b319f83353163ef3f4a288c",
  "workers_dev": false,
  "routes": [
    { "pattern": "estudiolcb.com.ar", "custom_domain": true },
    { "pattern": "www.estudiolcb.com.ar", "custom_domain": true }
  ],
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
